{
  "name": "automation-dq-web",
  "version": "1.0.0",
  "private": true,
  "description": "Website Automation DQ: kiến thức tự động hóa và bán source code",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/tailwind.css --minify",
    "build": "npm run build:css",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
